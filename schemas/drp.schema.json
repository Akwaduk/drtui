{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drtui.io/schemas/drp/v1alpha1.json",
  "title": "drtui Disaster Recovery Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "providers", "policy", "steps"],
  "properties": {
    "apiVersion": { "const": "drtui.io/v1alpha1" },
    "kind": { "const": "DisasterRecoveryPlan" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "inputs": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/inputDefinition" }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/provider" }
    },
    "transactions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/transaction" }
    },
    "policy": { "$ref": "#/$defs/policy" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
      "maxLength": 63
    },
    "duration": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:ms|s|m|h))+$"
    },
    "expression": {
      "type": "string",
      "pattern": "^\\$\\{\\{[ ]*(?:inputs|steps|secrets|item|runtime)(?:[.][A-Za-z_][A-Za-z0-9_-]*)+[ ]*\\}\\}$"
    },
    "valueType": {
      "enum": [
        "string",
        "integer",
        "number",
        "boolean",
        "ip",
        "path",
        "domain-list",
        "network-map",
        "object",
        "array",
        "secret"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "description": { "type": "string", "maxLength": 2000 },
        "labels": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9_.-]{1,63}$" },
          "additionalProperties": { "type": "string", "maxLength": 255 }
        }
      }
    },
    "inputDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/valueType" },
        "description": { "type": "string", "maxLength": 500 },
        "required": { "type": "boolean", "default": false },
        "default": true
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "version", "digest"],
      "properties": {
        "kind": {
          "enum": ["keyvault", "storage", "backup", "application", "dns", "infrastructure"]
        },
        "source": {
          "type": "string",
          "pattern": "^(?:oci|file)://[^\\s]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "config": {
          "type": "object",
          "description": "Validated again against the selected plugin's config schema."
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rollback"],
      "properties": {
        "rollback": { "enum": ["on-failure", "never"] }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxParallel",
        "failFast",
        "requireSignatures",
        "allowUnpinned",
        "workDirectory"
      ],
      "properties": {
        "maxParallel": { "type": "integer", "minimum": 1, "maximum": 128 },
        "failFast": { "type": "boolean" },
        "requireSignatures": { "type": "boolean" },
        "allowUnpinned": { "const": false },
        "workDirectory": {
          "type": "string",
          "minLength": 1,
          "description": "An engine-owned temporary root; expressions may use runtime.workDir below it."
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "backoff": { "$ref": "#/$defs/duration" },
        "maxBackoff": { "$ref": "#/$defs/duration" },
        "jitter": {
          "const": false,
          "description": "Random jitter is forbidden so retry timing remains reproducible."
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "from"],
      "properties": {
        "type": { "$ref": "#/$defs/valueType" },
        "from": {
          "type": "string",
          "pattern": "^result(?:[.][A-Za-z_][A-Za-z0-9_-]*)+$"
        },
        "sensitive": { "type": "boolean", "default": false }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "secret" } }, "required": ["type"] },
          "then": { "properties": { "sensitive": { "const": true } }, "required": ["sensitive"] }
        }
      ]
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uses", "timeout"],
      "properties": {
        "uses": {
          "type": "string",
          "pattern": "^(?:engine|[a-z][a-z0-9_-]*)/[A-Za-z][A-Za-z0-9_-]*$"
        },
        "with": { "type": "object" },
        "timeout": { "$ref": "#/$defs/duration" },
        "retry": { "$ref": "#/$defs/retry" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "uses", "timeout"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "uses": {
          "type": "string",
          "pattern": "^(?:engine|[a-z][a-z0-9_-]*)/[A-Za-z][A-Za-z0-9_-]*$"
        },
        "needs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "transaction": { "$ref": "#/$defs/identifier" },
        "if": { "$ref": "#/$defs/expression" },
        "forEach": { "$ref": "#/$defs/expression" },
        "with": { "type": "object" },
        "outputs": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/output" }
        },
        "timeout": { "$ref": "#/$defs/duration" },
        "retry": { "$ref": "#/$defs/retry" },
        "rollback": { "$ref": "#/$defs/rollback" }
      }
    }
  }
}