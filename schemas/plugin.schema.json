{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drtui.io/schemas/plugin/v1alpha1.json",
  "title": "drtui Provider Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "drtui.io/plugin/v1alpha1" },
    "kind": { "const": "ProviderPlugin" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 63
        },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "capabilities", "configSchema", "actions"],
      "properties": {
        "protocolVersion": { "type": "integer", "minimum": 1 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["keyvault", "storage", "backup", "application", "dns", "infrastructure"]
          }
        },
        "configSchema": { "$ref": "#/$defs/jsonSchema" },
        "actions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": { "$ref": "#/$defs/action" }
        }
      }
    }
  },
  "$defs": {
    "jsonPointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
    },
    "jsonSchema": {
      "type": "object",
      "required": ["$schema", "type"],
      "properties": {
        "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
        "type": { "const": "object" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "sideEffects",
        "idempotent",
        "inputSchema",
        "outputSchema"
      ],
      "properties": {
        "capability": {
          "enum": ["keyvault", "storage", "backup", "application", "dns", "infrastructure"]
        },
        "sideEffects": { "enum": ["none", "read", "write", "destructive"] },
        "idempotent": { "type": "boolean" },
        "retryableErrorCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["TRANSIENT", "TIMEOUT", "CONFLICT"]
          }
        },
        "sensitiveInputs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/jsonPointer" }
        },
        "sensitiveOutputs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/jsonPointer" }
        },
        "inputSchema": { "$ref": "#/$defs/jsonSchema" },
        "outputSchema": { "$ref": "#/$defs/jsonSchema" }
      }
    }
  }
}